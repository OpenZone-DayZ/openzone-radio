<!--
	Read by the ENGINE, wired up by CfgMods `inputs=`.

	A mod gets ONE inputs file: a second one is simply not read. Both of this
	mod's keys live here, and the PTT one used to live in OpenZone_PDA's --
	back when the radio could not exist without the PDA. It can now, so a key
	borrowed from another mod would be a key that vanishes with it.

	<sorting> is what makes a key VISIBLE and REBINDABLE in Settings ->
	Controls. Without it the input exists but the player can never find it.

	`loc` is a BARE stringtable key: no leading # and no $.

	Input names are global across every loaded mod, so they must be prefixed.

	The frequency window defaults to K: unbound in vanilla DayZ, and far from
	the movement cluster.

	Push-to-talk defaults to T (the owner's decision of 2026-09-26; it was the
	game's own voice key, CapsLock, before). T sits next to the movement
	cluster, so a player keeps running while holding it; vanilla binds T only
	as the base-building elevate modifier (UABuldElevateMod). With MirrorPtt
	on, the mod adds T as a second binding of the voice key on the client, so
	T = voice nearby + radio, and CapsLock stays voice nearby only.
-->
<modded_inputs>
	<inputs>
		<actions>
			<input name="UAOZRadioFreq" loc="oz_input_radio_freq"/>
			<input name="UAOZRadioPtt"  loc="oz_input_radio_ptt"/>
		</actions>
		<sorting name="openzone" loc="oz_input_group">
			<input name="UAOZRadioFreq"/>
			<input name="UAOZRadioPtt"/>
		</sorting>
	</inputs>
	<preset>
		<input name="UAOZRadioFreq">
			<btn name="kK"/>
		</input>
		<input name="UAOZRadioPtt">
			<btn name="kT"/>
		</input>
	</preset>
</modded_inputs>
