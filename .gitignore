# signing key — a leak lets anyone sign a mod as you
*.biprivatekey
keys/*.biprivatekey

# build output
build/out/
native/build/
# THE @Mod FOLDERS ARE BUILD OUTPUT AND ARE NOT IN GIT.
#
# mod_build writes addons/ into them and signs it; package.ps1 puts the rest
# in place from packaging/. Nothing in a @Mod folder is authored there.
#
# mod.cpp and meta.cpp were tracked inside them for one afternoon, which put
# source and output in the same directory and meant deleting a build folder
# would take the Workshop item id with it. They live in packaging/ now.
@OpenZone_Radio/
@OpenZone_Radio_PDA/
@OpenZone_Radio_VPP/
*.pbo
*.bisign
*.log
*.RPT

# local
.compile-check-profile/
.dayz-mcp/
Thumbs.db
desktop.ini

# машинний профіль MCP: шляхи цієї машини, не комітиться
dayz-mcp.local.toml

# Ті самі теки збірки, тимчасово перейменовані, щоб стенд їх не вантажив.
# Без цього рядка перейменування повертає в репозиторій усе, що з нього щойно
# прибрали -- pbo, підписи й копію ключа.
off-@*/
dayz-mcp.local.*.toml

# Python caches from tools/profiler
__pycache__/
