# signing key — a leak lets anyone sign a mod as you
*.biprivatekey
keys/*.biprivatekey

# build output
build/out/
native/build/
# THE @Mod FOLDERS ARE BUILD OUTPUT AND ARE NOT IN GIT.
#
# mod_build writes addons/ into them and signs it; package.ps1 puts the rest
# in place from packaging/. Nothing in a @Mod folder is authored there.
#
# mod.cpp and meta.cpp were tracked inside them for one afternoon, which put
# source and output in the same directory and meant deleting a build folder
# would take the Workshop item id with it. They live in packaging/ now.
@OpenZone_Radio/
@OpenZone_Radio_PDA/
@OpenZone_Radio_VPP/
*.pbo
*.bisign
*.log
*.RPT

# local
.compile-check-profile/
.dayz-mcp/
Thumbs.db
desktop.ini

# машинний профіль MCP: шляхи цієї машини, не комітиться
dayz-mcp.local.toml

# Ті самі теки збірки, тимчасово перейменовані, щоб стенд їх не вантажив.
# Без цього рядка перейменування повертає в репозиторій усе, що з нього щойно
# прибрали -- pbo, підписи й копію ключа.
off-@*/
dayz-mcp.local.*.toml

# Python caches from tools/profiler
__pycache__/

# Моделі рацій (models/). Корінь збірки моделей: MLOD і посилання на data\ та ванільний dz\
# (див. dayz-mcp.toml, [build] project_root) -- похідне, збирається заново.
build/model-root/
models/build/
# Проміжне конвеєра моделей: відтворюється скриптами models/assets/<рація>/scripts, і в git
# воно дало б дві копії, що розходяться. Що йде в мод (.p3d, .paa, .rvmat, model.cfg), лежить
# в OpenZone_Radio/model/ і комітиться. Виняток -- .blend: збірка зберігає сцену кожної рації
# (<рація>_high.blend -- детальна модель, <рація>_game.blend -- лоди в грі), щоб її можна було
# відкрити в Blender без прогону скриптів.
models/assets/*/work/*
!models/assets/*/work/*.blend
models/assets/*/textures/
# Чужий рендер, лежить на цій машині лише як візуальний референс.
models/assets/*/reference_*
*.blend1
