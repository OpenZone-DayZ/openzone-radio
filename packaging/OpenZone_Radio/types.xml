<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  OpenZone Radio - example central-economy entries.

  These six classes exist only in config.cpp until you add them here: the
  central economy does not spawn what it has not been told about, and a
  dropped item of an unknown type lives on the ground by rules you did not
  choose. Both are decided by types.xml, so this file ships with the mod.

  Everything is OPT-IN. nominal and min are 0: nothing spawns until you raise
  them. Copy the entries you want into your mission's db/types.xml, or add
  this file through cfgeconomycore.xml, and set the numbers for your server.

  lifetime is 86400 (24 h), three times the vanilla PersonalRadio's 28800.
  A radio left somewhere on purpose - a planted set with the latch on - has to
  outlive a day of play, or it is not a tool. Lower it if your server is
  littered; raise it if planted radios keep vanishing.

  The rest mirrors the vanilla PersonalRadio entry (category, tags, usage) so
  the sets turn up where a radio would, once you let them.
-->
<types>
    <type name="OZ_Radio_250m">
        <nominal>0</nominal>
        <lifetime>86400</lifetime>
        <restock>0</restock>
        <min>0</min>
        <quantmin>-1</quantmin>
        <quantmax>-1</quantmax>
        <cost>100</cost>
        <flags count_in_cargo="0" count_in_hoarder="0" count_in_map="1" count_in_player="0" crafted="0" deloot="0"/>
        <category name="tools"/>
        <tag name="shelves"/>
        <usage name="Military"/>
        <usage name="Police"/>
        <usage name="Medic"/>
        <usage name="Firefighter"/>
    </type>
